# Copy to .env. Secrets live only here — never in code, logs or chat.
GCP_PROJECT=your-gcp-project-id        # project with Vertex AI (Gemini, Lyria) and Cloud TTS/STT enabled; uses the gcloud login token
MAIL_TO=you@gmail.com                 # Gmail account that receives the reels (also the sender)
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx # Google account > Security > App passwords
YOUTUBE_API_KEY=                       # optional: YouTube Data API v3 for most-popular charts and 48-hour search
CHANNEL_NAME=MyChannel                 # channel display name used in prompts and email subjects
HANDLE=@mychannel                      # on-screen handle (top-right) and QA check
